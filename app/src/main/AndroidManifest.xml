<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    
    <!-- Navigation SDK permissions -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" /> <!-- Telephony features - ADDED THESE -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony.gsm"
        android:required="false" /> <!-- Location features - RECOMMENDED TO ADD -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SAGIP_prototype"
        tools:targetApi="31"
        android:extractNativeLibs="true">

        <!-- Google Maps Activity -->
        <activity
            android:name=".MyGoogleMAp"
            android:exported="false"
            android:label="Emergency Location Map (Google)" />

        <!-- Senior Google Maps Activity -->
        <activity
            android:name=".Senior_GoogleMap"
            android:exported="false"
            android:label="Senior Emergency Map"
            android:screenOrientation="portrait" />

        <!-- Rescuer Navigation Activity -->
        <activity
            android:name=".RescuerNavigationActivity"
            android:exported="false"
            android:label="Rescuer Navigation"
            android:screenOrientation="portrait" />

        <!-- Rescuer Navigation SDK Activity -->
        <activity
            android:name=".RescuerNavigationSDKActivity"
            android:exported="false"
            android:label="Rescuer Navigation (SDK)"
            android:screenOrientation="portrait" />

        <!-- Emergency List Activity -->
        <activity
            android:name=".EmergencyListActivity"
            android:exported="false"
            android:label="Emergency List"
            android:screenOrientation="portrait" />



        <activity
            android:name=".Senior_add_Emergency_Contact"
            android:exported="false" />
        <activity
            android:name=".Barangay_Registration"
            android:exported="false" />
        <activity
            android:name=".Hospital_List"
            android:exported="false" />
        <activity
            android:name=".Hospital_Profile"
            android:exported="false" />
        <activity
            android:name=".Rescuer_List"
            android:exported="false" />
        <activity
            android:name=".Rescuer_Profile"
            android:exported="false" />
        <activity
            android:name=".Barangay_List"
            android:exported="false" />
        <activity
            android:name=".Barangay_Profile"
            android:exported="false" />
        <activity
            android:name=".Hospital_Registration"
            android:exported="false" />
        <activity
            android:name=".Rescuer_Registration"
            android:exported="false" />
        <activity
            android:name=".Senior_Update_Profile"
            android:exported="false" />
        <activity
            android:name=".Senior_Profile"
            android:exported="false" />
        <activity
            android:name=".Senior_Emergency_Contact"
            android:exported="false" />
        <activity
            android:name=".Hospital_Status_Edit"
            android:exported="false" />
        <!-- File provider declaration -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.sagip_prototype.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".Barangay_Dashboard"
            android:exported="false" />
        <activity
            android:name=".Hospital_Dashboard"
            android:exported="false" />
        <activity
            android:name=".Rescuer_Dashboard"
            android:exported="false" />
        <activity
            android:name=".Senior_Dashboard"
            android:exported="false" />
        <activity
            android:name=".Selfie_verification"
            android:exported="false" />
        <activity
            android:name=".Verification_Page"
            android:exported="false" />
        <activity
            android:name=".IdCameraCapture"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="unspecified" />
        <activity
            android:name=".FaceVerification"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".Senior_Registration"
            android:exported="false" />
        <activity
            android:name=".OTP_PAGE"
            android:exported="false" />
        <activity
            android:name=".LanguageSelectionActivity"
            android:exported="false" />
        <activity
            android:name=".EmailVerificationActivity"
            android:exported="false" />

        <!-- Feedback and Reporting Activities -->
        <activity
            android:name=".FeedbackActivity"
            android:exported="false"
            android:label="@string/feedback_title" />
        <activity
            android:name=".MyReportsActivity"
            android:exported="false"
            android:label="@string/feedback_my_reports" />
        <activity
            android:name=".AdminFeedbackActivity"
            android:exported="false"
            android:label="@string/admin_feedback_title" />


        <!-- Rescuer Background Notification Service -->
        <service
            android:name=".RescuerBackgroundNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".FCMNotificationService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Background Notification Listener Service -->
        <service
            android:name=".BackgroundNotificationListener"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Background Notification Service for monitoring notifications when app is closed -->
        <service
            android:name=".BackgroundNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Rescuer Foreground Service for ensuring rescuers get notifications when app is closed -->
        <service
            android:name=".RescuerForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        
        <!-- WebSocket-based notification service (FCM alternative) -->
        <service
            android:name=".WebSocketNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".HospitalStatusReminderService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".HospitalStatusNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Emergency Notification Service for real-time SOS alerts -->
        <service
            android:name=".EmergencyNotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- GlobalTimerService removed - using simple timer with SharedPreferences -->

        <!-- Boot Receiver for rescheduling notifications -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />


    </application>

</manifest>