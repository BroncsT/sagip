<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Semi-transparent background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80000000" />
        </shape>
    </item>
    
    <!-- Clean white rectangular frame for ID -->
    <item android:left="30dp" android:top="100dp" android:right="30dp" android:bottom="150dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="4dp" android:color="#FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    
    <!-- Corner indicators for better alignment -->
    <!-- Top Left corner -->
    <item android:left="30dp" android:top="100dp" android:right="50dp" android:bottom="120dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="6dp" android:color="#FFFFFF" />
        </shape>
    </item>
    
    <!-- Top Right corner -->
    <item android:left="50dp" android:top="100dp" android:right="30dp" android:bottom="120dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="6dp" android:color="#FFFFFF" />
        </shape>
    </item>
    
    <!-- Bottom Left corner -->
    <item android:left="30dp" android:top="130dp" android:right="50dp" android:bottom="150dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="6dp" android:color="#FFFFFF" />
        </shape>
    </item>
    
    <!-- Bottom Right corner -->
    <item android:left="50dp" android:top="130dp" android:right="30dp" android:bottom="150dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="6dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>