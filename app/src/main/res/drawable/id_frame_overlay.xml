<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Semi-transparent background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80000000" />
        </shape>
    </item>
    
    <!-- Transparent rectangle for ID frame -->
    <item android:left="40dp" android:top="80dp" android:right="40dp" android:bottom="120dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    
    <!-- Corner markers - Top Left -->
    <item android:left="40dp" android:top="80dp" android:right="60dp" android:bottom="100dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="4dp" android:color="#FFFFFF" />
        </shape>
    </item>
    
    <!-- Corner markers - Top Right -->
    <item android:left="60dp" android:top="80dp" android:right="40dp" android:bottom="100dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="4dp" android:color="#FFFFFF" />
        </shape>
    </item>
    
    <!-- Corner markers - Bottom Left -->
    <item android:left="40dp" android:top="100dp" android:right="60dp" android:bottom="120dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="4dp" android:color="#FFFFFF" />
        </shape>
    </item>
    
    <!-- Corner markers - Bottom Right -->
    <item android:left="60dp" android:top="100dp" android:right="40dp" android:bottom="120dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="4dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
