<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OpenStreetMap Examples"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnRescuerMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚑 Rescuer Mode"
        android:textSize="16sp"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_background"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/btnSeniorMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👴 Senior Tracking Mode"
        android:textSize="16sp"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_background"
        android:textColor="@android:color/white" />

    <Button
        android:id="@+id/btnEmergencyMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚨 Emergency Mode"
        android:textSize="16sp"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_background"
        android:textColor="@android:color/white" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This demonstrates the OpenStreetMap implementation with the same functionality as Google Maps but using free, open-source mapping data."
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:padding="16dp" />

</LinearLayout>
