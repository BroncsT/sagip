<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/padding_small"
    android:layout_marginEnd="@dimen/padding_small"
    android:layout_marginBottom="@dimen/spacing_medium"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_large">

        <!-- Profile Image with enhanced styling -->
        <ImageView
            android:id="@+id/seniorImgView"
            android:layout_width="@dimen/profile_image_medium"
            android:layout_height="@dimen/profile_image_medium"
            android:layout_marginStart="@dimen/spacing_tiny"
            android:adjustViewBounds="true"
            android:background="@drawable/profile_image_background"
            android:cropToPadding="true"
            android:padding="@dimen/spacing_tiny"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Text Container -->
        <LinearLayout
            android:id="@+id/textContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/seniorImgView"
            app:layout_constraintEnd_toStartOf="@id/actionContainer"
            app:layout_constraintStart_toEndOf="@id/seniorImgView"
            app:layout_constraintTop_toTopOf="@id/seniorImgView">

            <!-- Senior Name -->
            <TextView
                android:id="@+id/seniorProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/black"
                android:textSize="@dimen/text_size_xlarge"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                tools:hint="Juan Dela Cruz" />

            <!-- Age -->
            <TextView
                android:id="@+id/seniorAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:textColor="@color/gray"
                android:textSize="@dimen/text_size_medium"
                android:fontFamily="sans-serif"
                tools:hint="Age: 65 years old" />

            <!-- Phone Number -->
            <TextView
                android:id="@+id/seniorAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/gray"
                android:textSize="@dimen/text_size_medium"
                android:fontFamily="sans-serif"
                tools:hint="+63 961 011 3560" />

        </LinearLayout>

        <!-- Action Container -->
        <LinearLayout
            android:id="@+id/actionContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- View Profile Button -->
            <TextView
                android:id="@+id/viewSeniorProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/view_profile_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="@dimen/button_padding_horizontal"
                android:paddingStart="@dimen/padding_medium"
                android:paddingEnd="@dimen/padding_medium"
                android:paddingTop="@dimen/padding_small"
                android:paddingBottom="@dimen/padding_small"
                android:text="View Profile"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_medium"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
