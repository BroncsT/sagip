<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray"
    android:fillViewport="true">

    <!-- Stepper Section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/stepView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:cardElevation="3dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="5dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Step 3 of 4"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="5dp"
                android:text="ID Verification"
                android:textColor="@color/backgroundRed"
                android:textStyle="bold"
                android:textSize="18sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/textinstruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/verify_instruction"
        android:textSize="16sp"
        android:textColor="@color/gray"
        app:layout_constraintStart_toStartOf="@id/guidelineVertical1v2"
        app:layout_constraintEnd_toEndOf="@id/guidelineVertical2v2"
        app:layout_constraintTop_toBottomOf="@id/stepView"/>

    <TextView
        android:id="@+id/GovernemntLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Government Document Type"
        android:textColor="@color/black"
        android:textSize="19sp"
        android:textStyle="bold"
        android:drawablePadding="5dp"
        app:layout_constraintStart_toStartOf="@id/guidelineVertical1v2"
        app:layout_constraintEnd_toEndOf="@id/guidelineVertical2v2"
        app:layout_constraintTop_toBottomOf="@id/textinstruction"/>

    <TextView
        android:id="@+id/textinstruction3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/ID_verify_instruction"
        android:textSize="14sp"
        android:textColor="@color/gray"
        app:layout_constraintStart_toStartOf="@id/guidelineVertical1v2"
        app:layout_constraintEnd_toEndOf="@id/guidelineVertical2v2"
        app:layout_constraintTop_toBottomOf="@id/GovernemntLabel"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/idTypeInputLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/select_id_type"
            android:layout_marginTop="10dp"
            app:boxStrokeColor="@color/dark_blue"
            app:hintTextColor="@color/dark_blue"
            app:layout_constraintEnd_toEndOf="@id/guidelineVertical2v2"
            app:layout_constraintStart_toStartOf="@id/guidelineVertical1v2"
            app:layout_constraintTop_toBottomOf="@id/textinstruction3">

            <AutoCompleteTextView
                android:id="@+id/idTypeDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardFrontID"
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:layout_marginTop="30dp"
            android:background="@color/white"
            app:cardElevation="3dp"
            app:cardCornerRadius="6dp"
            app:layout_constraintStart_toStartOf="@id/guidelineVertical1v2"
            app:layout_constraintEnd_toEndOf="@id/guidelineVertical2v2"
            app:layout_constraintTop_toBottomOf="@id/idTypeInputLayout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="12dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- Front ID Photo Section -->
                <TextView
                    android:id="@+id/frontIdPhotoLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="@string/front_of_id"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/frontIdPhotoCardView"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp"
                    android:outlineSpotShadowColor="@color/white"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/frontIdPhotoLabel"
                    app:strokeColor="#DDDDDD"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/frontIdPhotoImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#F5F5F5"
                        android:contentDescription="Front ID Photo"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:rotation="0"
                        android:padding="8dp" />

                    <TextView
                        android:id="@+id/frontIdPlaceholderText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:drawableTint="#AAAAAA"
                        android:text="@string/tap_to_upload_front"
                        android:textColor="#AAAAAA"
                        android:visibility="visible"
                        app:drawableTopCompat="@drawable/baseline_photo_camera_24" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="5dp"
                    android:text="@string/valid_id_instruction"
                    android:textColor="@color/gray"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:layout_marginTop="30dp"
            android:background="@color/white"
            app:cardElevation="3dp"
            app:cardCornerRadius="6dp"
            app:layout_constraintStart_toStartOf="@id/guidelineVertical1v2"
            app:layout_constraintEnd_toEndOf="@id/guidelineVertical2v2"
            app:layout_constraintTop_toBottomOf="@id/cardFrontID">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="12dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- Back ID Photo Section -->
                <TextView
                    android:id="@+id/backIdPhotoLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/back_of_id"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/backIdPhotoCardView"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="8dp"
                    android:outlineSpotShadowColor="@color/white"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/backIdPhotoLabel"
                    app:strokeColor="#DDDDDD"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:id="@+id/backIdPhotoImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#F5F5F5"
                        android:contentDescription="Back ID Photo"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:rotation="0"
                        android:padding="8dp" />

                    <TextView
                        android:id="@+id/backIdPlaceholderText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="@string/tap_to_upload_back"
                        android:textColor="#AAAAAA"
                        android:visibility="visible"
                        app:drawableTopCompat="@drawable/baseline_photo_camera_24"
                        android:drawableTint="#AAAAAA"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="5dp"
                    android:text="@string/valid_id_instruction"
                    android:textColor="@color/gray"
                    android:textSize="12sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    <!-- Security Note -->
    <TextView
        android:id="@+id/privacyTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:drawablePadding="8dp"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:text="@string/privacy_text"
        android:textColor="#6C757D"
        android:textSize="12sp"
        app:drawableStartCompat="@drawable/ic_security"
        app:layout_constraintStart_toStartOf="@id/guidelineVertical1v2"
        app:layout_constraintEnd_toEndOf="@id/guidelineVertical2v2"
        app:layout_constraintBottom_toTopOf="@id/nextButton"/>

    <!-- Upload Buttons removed per requirement -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/nextButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:layout_marginBottom="30dp"
        android:paddingVertical="16dp"
        android:backgroundTint="@color/backgroundRed"
        android:text="Submit for ID Verification"
        android:textAllCaps="true"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/guidelineVertical2v2"
        app:layout_constraintStart_toStartOf="@id/guidelineVertical1v2" />

    <!--GRID GUIDELINE-->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.10" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical1v2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.90" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical2v2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.25" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical3.5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.50" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.75" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="22dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal1v2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="44dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.11" />
</androidx.constraintlayout.widget.ConstraintLayout>
