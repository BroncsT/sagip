<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray"
    tools:context=".OTP_PAGE">

    <!-- Stepper Section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/stepView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:cardElevation="3dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_tiny"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/stepNumberText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Step 1 of 4"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_xlarge" />

            <TextView
                android:id="@+id/stepTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="Verify your number"
                android:textColor="@color/backgroundRed"
                android:textStyle="bold"
                android:textSize="@dimen/text_size_xlarge" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Header Section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/headerCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_large"
        app:cardCornerRadius="6dp"
        app:cardElevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/stepView"
        app:layout_constraintStart_toStartOf="@id/guidelineVertical1v2"
        app:layout_constraintEnd_toEndOf="@id/guidelineVertical2v2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium"
            android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/minus_button"
                android:layout_width="@dimen/icon_size_medium"
                android:layout_height="@dimen/icon_size_medium"
                android:src="@drawable/app_logo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:text="@string/app_name"
                android:textColor="#212529"
                android:textSize="@dimen/text_size_xlarge" />

        </LinearLayout>

            <TextView
                android:id="@+id/instructionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:fontFamily="sans-serif"
                android:text="@string/instruction_text_otp"
                android:textAlignment="center"
                android:textColor="#495057"
                android:textSize="@dimen/text_size_large" />

            <TextView
                android:id="@+id/mobilenumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:fontFamily="sans-serif-medium"
                android:text="@string/mobile_number"
                android:textColor="@color/blue"
                android:textSize="@dimen/text_size_xxlarge" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/textCode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/enter_verification_code"
        android:textColor="@color/black"
        android:textSize="@dimen/text_size_large"
        android:layout_marginBottom="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_medium"
        app:layout_constraintStart_toStartOf="@id/guidelineVertical1v2"
        app:layout_constraintEnd_toEndOf="@id/guidelineVertical2v2"
        app:layout_constraintTop_toBottomOf="@id/headerCard"/>

    <!-- OTP Input Section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/otpCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        app:cardCornerRadius="6dp"
        app:cardElevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/textCode"
        app:layout_constraintStart_toStartOf="@id/guidelineVertical1v2"
        app:layout_constraintEnd_toEndOf="@id/guidelineVertical2v2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/otpInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/otp_hint"
                app:cursorColor="@color/secondaryRed"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/otpInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLength="6"
                    android:padding="@dimen/padding_medium"
                    android:textSize="@dimen/text_size_xlarge" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- OTP Timer and Resend -->
            <TextView
                android:id="@+id/timerTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:gravity="center"
                android:textAlignment="center"
                android:text="Resend OTP in 01:00"
                android:textColor="@color/secondaryRed"
                android:textSize="@dimen/text_size_medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_medium"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/textNotReceive"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/didnt_receive_code"
                    android:textColor="#555555"
                    android:textSize="@dimen/text_size_medium" />

                <TextView
                    android:id="@+id/resendOtpTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/padding_small"
                    android:text="@string/resend_otp"
                    android:textColor="@color/blue"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Verify Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/verifyButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:paddingVertical="@dimen/padding_medium"
        android:text="@string/verify_button"
        android:textAllCaps="false"
        android:textSize="@dimen/text_size_large"
        android:textColor="@color/white"
        android:fontFamily="sans-serif-medium"
        app:cornerRadius="8dp"
        app:backgroundTint="#3E69E0"
        app:layout_constraintTop_toBottomOf="@id/otpCard"
        app:layout_constraintStart_toStartOf="@id/guidelineVertical1v2"
        app:layout_constraintEnd_toEndOf="@id/guidelineVertical2v2" />

    <!-- Security Note -->
    <TextView
        android:id="@+id/securityNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/padding_large"
        android:drawablePadding="@dimen/padding_small"
        android:fontFamily="sans-serif"
        android:gravity="center_vertical"
        android:text="@string/security_note"
        android:textColor="#6C757D"
        android:textSize="@dimen/text_size_small"
        app:drawableStartCompat="@drawable/ic_security"
        app:layout_constraintTop_toBottomOf="@id/verifyButton"
        app:layout_constraintStart_toStartOf="@id/guidelineVertical1v2"
        app:layout_constraintEnd_toEndOf="@id/guidelineVertical2v2" />

    <!--GRID GUIDELINE-->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.10" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical1v2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.90" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical2v2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.25" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical3.5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.50" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineVertical4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.75" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="22dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal1v2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="44dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineHorizontal2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.11" />

</androidx.constraintlayout.widget.ConstraintLayout>
