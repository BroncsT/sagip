<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_large"
        android:gravity="center_horizontal">

        <!-- Welcome Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_to"
                android:textSize="@dimen/text_size_large"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:textColor="#555555" />

            <!-- App Logo and Name -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <ImageView
                    android:layout_width="@dimen/icon_size_large"
                    android:layout_height="@dimen/icon_size_large"
                    android:src = "@drawable/app_logo"
                    android:contentDescription="@string/app_name"
                    android:layout_marginEnd="@dimen/spacing_medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#3E69E0"
                    android:textSize="@dimen/text_size_headline"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/loginPromptText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:layout_marginBottom="@dimen/spacing_xlarge"
                android:gravity="center"
                android:text="@string/enter_number_prompt"
                android:textColor="#333333"
                android:textSize="@dimen/text_size_xlarge"/>
        </LinearLayout>

        <!-- Language Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="end">

            <TextView
                android:id="@+id/languageSelectionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_language"
                android:textColor="#3E69E0"
                android:textSize="@dimen/text_size_medium"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"
                android:padding="@dimen/padding_small" />
        </LinearLayout>

        <!-- Login Method Toggle -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/phoneTabButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_small"
                    android:layout_weight="1"
                    android:background="@drawable/tab_selector"
                    android:gravity="center"
                    android:text="@string/phone"
                    android:textColor="#3E69E0"
                    android:textSize="@dimen/text_size_medium"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/emailTabButton"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_small"
                    android:layout_weight="1"
                    android:background="@drawable/tab_selector"
                    android:gravity="center"
                    android:text="@string/email"
                    android:textColor="#999999"
                    android:textSize="@dimen/text_size_medium"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Phone Input Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/phoneInputCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:visibility="visible"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:id="@+id/phone_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/padding_medium">



                <EditText
                    android:id="@+id/user_number"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/mobile_hint"
                    android:inputType="phone"
                    android:textColor="#333333"
                    android:textSize="@dimen/text_size_large" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Email Input Section -->
        <LinearLayout
            android:id="@+id/emailInputSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Email Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/padding_medium">

                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:src="@drawable/ic_email"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="@dimen/spacing_medium"
                        android:contentDescription="Email" />

                    <EditText
                        android:id="@+id/emailInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/email_address"
                        android:inputType="text"
                        android:textColor="#333333"
                        android:textSize="@dimen/text_size_large" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Password Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/passwordInputCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/padding_medium">

                    <ImageView
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:src="@drawable/ic_lock"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="@dimen/spacing_medium"
                        android:contentDescription="Password" />

                    <EditText
                        android:id="@+id/passwordInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/password"
                        android:inputType="textPassword"
                        android:textColor="#333333"
                        android:textSize="@dimen/text_size_large" />

                    <ImageView
                        android:id="@+id/passwordToggle"
                        android:layout_width="@dimen/icon_size_small"
                        android:layout_height="@dimen/icon_size_small"
                        android:src="@drawable/ic_visibility_off"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="Toggle password visibility"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/spacing_tiny" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Forgot Password -->
            <LinearLayout
                android:id="@+id/forgotPasswordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="end">

                <TextView
                    android:id="@+id/forgotPasswordText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_password"
                    android:textColor="#3E69E0"
                    android:textSize="@dimen/text_size_medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="@dimen/padding_small" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/errorTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:visibility="gone"
            android:text="@string/invalid_mobile_error"
            android:textColor="#FF5252"
            android:textSize="@dimen/text_size_medium" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="@dimen/icon_size_medium"
            android:layout_height="@dimen/icon_size_medium"
            android:layout_marginTop="@dimen/spacing_large"
            android:visibility="gone"
            android:indeterminateTint="#3E69E0" />

        <Button
            android:id="@+id/login_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/margin_medium"
            android:text="@string/continue_btn"
            android:textSize="@dimen/text_size_large"
            android:textAllCaps="false"
            app:cornerRadius="@dimen/button_corner_radius"
            android:backgroundTint="#3E69E0" />

        <!-- Alternative Login Options -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/senior_register"
            style="@style/FeatureCardStyle">

            <LinearLayout style="@style/FeatureLayoutStyle">

                <ImageView
                    android:layout_width="@dimen/icon_size_medium"
                    android:layout_height="@dimen/icon_size_medium"
                    android:src="@drawable/ic_senior"
                    android:contentDescription="@string/hospital_title"
                    android:layout_marginEnd="@dimen/padding_medium" />


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/senior_title"
                        style="@style/FeatureTitleStyle"
                        android:text="@string/senior_title" />

                    <TextView
                        android:id="@+id/senior_description"
                        style="@style/FeatureDescriptionStyle"
                        android:text="@string/senior_description" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Feature 1 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/brgy_register"
                style="@style/FeatureCardStyle">

                <LinearLayout style="@style/FeatureLayoutStyle">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:src="@drawable/ic_brgy"
                        android:contentDescription="@string/senior_title"
                        android:layout_marginEnd="@dimen/padding_medium" />


                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/barangay_title"
                            style="@style/FeatureTitleStyle"
                            android:text="@string/barangay_title" />

                        <TextView
                            android:id="@+id/barangay_description"
                            style="@style/FeatureDescriptionStyle"
                            android:text="@string/barangay_description" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Feature 2 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/register_rescue"
                style="@style/FeatureCardStyle">

                <LinearLayout style="@style/FeatureLayoutStyle">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:src="@drawable/ic_ambulance"
                        android:contentDescription="@string/rescue_title"
                        android:layout_marginEnd="@dimen/padding_medium" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/rescue_title"
                            style="@style/FeatureTitleStyle"
                            android:text="@string/rescue_title" />

                        <TextView
                            android:id="@+id/rescue_description"
                            style="@style/FeatureDescriptionStyle"
                            android:text="@string/rescue_description" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Feature 3 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/hospital_register"
                style="@style/FeatureCardStyle">

                <LinearLayout style="@style/FeatureLayoutStyle">

                    <ImageView
                        android:layout_width="@dimen/icon_size_medium"
                        android:layout_height="@dimen/icon_size_medium"
                        android:src="@drawable/hospital"
                        android:contentDescription="@string/hospital_title"
                        android:layout_marginEnd="@dimen/padding_medium" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/hospital_title"
                            style="@style/FeatureTitleStyle"
                            android:text="@string/hospital_title" />

                        <TextView
                            android:id="@+id/hospital_description"
                            style="@style/FeatureDescriptionStyle"
                            android:text="@string/hospital_description" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>