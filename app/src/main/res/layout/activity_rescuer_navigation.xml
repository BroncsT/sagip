<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top green navigation banner -->
    <LinearLayout
        android:id="@+id/topNavigationBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/navigation_banner_background"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:elevation="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_location_pin"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRemainingDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="180 m"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDestinationName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency Location"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvCurrentInstruction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Turn right in 50 meters"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Back button -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:background="@drawable/circle_background"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Back"
        android:elevation="4dp" />

    <!-- Speed indicator (bottom-left) -->
    <LinearLayout
        android:id="@+id/speedIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_margin="16dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/circle_background"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center"
        android:elevation="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvCurrentSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 km/h"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Map controls (right side) -->
    <LinearLayout
        android:id="@+id/mapControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <!-- Compass button -->
        <ImageButton
            android:id="@+id/btnCompass"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/circle_background"
            android:src="@drawable/ic_compass"
            android:contentDescription="Compass"
            android:elevation="4dp" />

        <!-- Zoom in button -->
        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/circle_background"
            android:src="@drawable/ic_zoom_in"
            android:contentDescription="Zoom In"
            android:elevation="4dp" />

        <!-- Audio toggle button -->
        <ImageButton
            android:id="@+id/btnAudioToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_background"
            android:src="@drawable/ic_volume_on"
            android:contentDescription="Audio Toggle"
            android:elevation="4dp" />

    </LinearLayout>

    <!-- Bottom navigation summary bar (Google Maps style) -->
    <LinearLayout
        android:id="@+id/bottomNavigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@android:color/white"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="8dp"
        android:visibility="gone">

        <!-- Cancel navigation button -->
        <ImageButton
            android:id="@+id/btnCancelNavigation"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/circle_background"
            android:src="@drawable/ic_close"
            android:contentDescription="Cancel Navigation"
            android:elevation="4dp" />

        <!-- Navigation summary -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvEstimatedTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 min"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvRemainingDistanceBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="180 m"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvArrivalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4:16 PM"
                android:textColor="@android:color/darker_gray"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Route options button -->
        <ImageButton
            android:id="@+id/btnRouteOptions"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/circle_background"
            android:src="@drawable/ic_route_options"
            android:contentDescription="Route Options"
            android:elevation="4dp" />

    </LinearLayout>

    <!-- Emergency info card -->
    <LinearLayout
        android:id="@+id/emergencyInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:background="@drawable/card_background"
        android:orientation="vertical"
        android:padding="16dp"
        android:elevation="6dp">

        <TextView
            android:id="@+id/tvEmergencyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚨 EMERGENCY LOCATION"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvEmergencyAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Location address will appear here"
            android:textSize="14sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDistanceTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textSize="12sp"
            android:textColor="@android:color/holo_blue_dark"
            android:gravity="center"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNavigationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📍 Ready to navigate"
            android:textSize="12sp"
            android:textColor="@android:color/holo_green_dark"
            android:gravity="center"
            android:textStyle="bold" />

        <!-- Turn-by-turn navigation instructions -->
        <TextView
            android:id="@+id/tvCurrentInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textSize="16sp"
            android:textColor="@android:color/holo_blue_dark"
            android:gravity="center"
            android:textStyle="bold"
            android:background="@drawable/card_background"
            android:padding="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNextInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textSize="12sp"
            android:textColor="@android:color/holo_orange_dark"
            android:gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStepCounter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textSize="10sp"
            android:textColor="@android:color/darker_gray"
            android:gravity="center"
            android:visibility="gone" />

        <!-- Navigation buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnStartNavigation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="🗺️ Start Navigation"
                android:textSize="12sp"
                android:background="@drawable/button_background"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnStopNavigation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="⏹️ Stop Navigation"
                android:textSize="12sp"
                android:background="@drawable/button_background"
                android:textColor="@android:color/white"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Turn-by-turn navigation controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnToggleVoice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="🔊 Voice ON"
                android:textSize="12sp"
                android:background="@drawable/button_background"
                android:textColor="@android:color/white"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnPreviousStep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="⬅️ Previous"
                android:textSize="12sp"
                android:background="@drawable/button_background"
                android:textColor="@android:color/white"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnNextStep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="➡️ Next"
                android:textSize="12sp"
                android:background="@drawable/button_background"
                android:textColor="@android:color/white"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnCallSenior"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="📞 Call Senior"
                android:textSize="12sp"
                android:background="@drawable/button_background"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnOpenExternalMaps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🚗 Google Maps"
                android:textSize="12sp"
                android:background="@drawable/button_background"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <!-- Arrived button -->
        <Button
            android:id="@+id/btnArrived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="✅ Mark as Arrived"
            android:textSize="14sp"
            android:background="@drawable/button_background"
            android:textColor="@android:color/white"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>
