<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".Senior_GoogleMap">

    <!-- Google Map Fragment -->
    <fragment
        android:id="@+id/seniorMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/emergencyInfoCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Emergency Info Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/emergencyInfoCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Emergency Title -->
            <TextView
                android:id="@+id/tvEmergencyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚨 Emergency Help Request"
                android:textColor="@color/primaryRed"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Senior Location -->
            <TextView
                android:id="@+id/tvEmergencyAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📍 Your current location"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:gravity="center" />

            <!-- Rescuer Information -->
            <TextView
                android:id="@+id/tvRescuerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="⏳ Waiting for rescuers to respond..."
                android:textColor="@color/gray"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp" />

            <!-- Close Button -->
            <Button
                android:id="@+id/btnCloseMap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_primary_background"
                android:text="Close Map"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
